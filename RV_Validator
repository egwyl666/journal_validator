<#
  RV-Validation.ps1 - control validation after closing audit gaps (ASCII only, no encoding issues).
  Creates test events (everything is removed right away), checks them in local event logs,
  checks the Wazuh agent and saves results to C:\SOC_Audit\RV-validation-<host>-<time>.txt / .csv
  Run as Administrator:
    powershell -ExecutionPolicy Bypass -File .\RV-Validation.ps1
#>
param([switch]$PsStats)
$ErrorActionPreference = 'Continue'
function Step { param($t) Write-Host ("[{0}] {1}" -f (Get-Date -Format 'HH:mm:ss'), $t) -ForegroundColor Cyan }
$out = 'C:\SOC_Audit'; New-Item -ItemType Directory -Force $out | Out-Null
$stamp = Get-Date -Format 'yyyyMMdd_HHmmss'
$txt = Join-Path $out "RV-validation-$env:COMPUTERNAME-$stamp.txt"
$csv = Join-Path $out "RV-validation-$env:COMPUTERNAME-$stamp.csv"
$marker = "RVTEST$stamp"
Start-Transcript -LiteralPath $txt | Out-Null

$start = (Get-Date).AddSeconds(-2)
Write-Host ("=== RV validation | host {0} | start {1} (UTC {2}) | marker {3} ===" -f $env:COMPUTERNAME, $start.ToString('yyyy-MM-dd HH:mm:ss'), $start.ToUniversalTime().ToString('yyyy-MM-dd HH:mm:ss'), $marker) -ForegroundColor Cyan

# --- 1. Generate events ---
Step "[1] Generating test events"
Step "  4688: cmd /c echo marker"
cmd.exe /c "echo $marker" | Out-Null
Step "  4625 + 4776: failed local logon (non-interactive)"
try {
  Add-Type -AssemblyName System.DirectoryServices.AccountManagement
  $ctx = New-Object System.DirectoryServices.AccountManagement.PrincipalContext([System.DirectoryServices.AccountManagement.ContextType]::Machine)
  [void]$ctx.ValidateCredentials('rv_fake_user', 'WrongPass_123'); $ctx.Dispose()
} catch { Write-Host "    failed: $($_.Exception.Message)" -ForegroundColor Yellow }
Step "  4697 + 7045: sc create / delete"
sc.exe create "$marker-svc" binPath= "C:\Windows\System32\cmd.exe /c exit" | Out-Null
sc.exe delete "$marker-svc" | Out-Null
Step "  4698 / 4699: schtasks create / delete"
schtasks /create /tn "$marker-task" /tr notepad.exe /sc once /st 23:59 /f 2>&1 | Out-Null
schtasks /delete /tn "$marker-task" /f 2>&1 | Out-Null
Step "  4946 / 4948: firewall rule add / remove"
New-NetFirewallRule -DisplayName "$marker-fw" -Direction Inbound -Action Block -Protocol TCP -LocalPort 65000 | Out-Null
Remove-NetFirewallRule -DisplayName "$marker-fw"
Step "  5140: access to \\127.0.0.1\C$"
Get-ChildItem '\\127.0.0.1\C$' -ErrorAction SilentlyContinue | Select-Object -First 1 | Out-Null
Start-Sleep 5

# --- 2. Check local event logs ---
Step "[2] Checking local event logs"
$tests = @(
  @{ Test = "cmd /c echo marker";            Id = 4688; Log = 'Security'; Match = $marker;        Before = 'No auditing';              After = 'Success + CommandLine' }
  @{ Test = 'failed logon rv_fake_user';     Id = 4625; Log = 'Security'; Match = 'rv_fake_user'; Before = 'Visible';                  After = 'Visible' }
  @{ Test = 'failed logon rv_fake_user';     Id = 4776; Log = 'Security'; Match = 'rv_fake_user'; Before = 'Success only';             After = 'Success and Failure' }
  @{ Test = 'sc create / delete';            Id = 4697; Log = 'Security'; Match = $marker;        Before = 'No auditing';              After = 'Success' }
  @{ Test = 'sc create / delete';            Id = 7045; Log = 'System';   Match = $marker;        Before = 'Always logged';            After = 'Always logged' }
  @{ Test = 'schtasks /create';              Id = 4698; Log = 'Security'; Match = $marker;        Before = 'TaskScheduler 106 only';   After = '4698 with task XML' }
  @{ Test = 'schtasks /delete';              Id = 4699; Log = 'Security'; Match = $marker;        Before = 'TaskScheduler 141 only';   After = '4699' }
  @{ Test = 'New-NetFirewallRule';           Id = 4946; Log = 'Security'; Match = $marker;        Before = 'Firewall 2004 only';       After = '4946' }
  @{ Test = 'Remove-NetFirewallRule';        Id = 4948; Log = 'Security'; Match = $marker;        Before = 'Firewall 2006 only';       After = '4948' }
  @{ Test = 'dir \\127.0.0.1\C$';             Id = 5140; Log = 'Security'; Match = 'C$';           Before = 'No auditing';              After = 'Success' }
)
$rows = foreach ($t in $tests) {
  $ev = @(Get-WinEvent -FilterHashtable @{ LogName = $t.Log; Id = $t.Id; StartTime = $start } -ErrorAction SilentlyContinue)
  $hit = @($ev | Where-Object { $_.Message -and $_.Message.IndexOf($t.Match, [StringComparison]::OrdinalIgnoreCase) -ge 0 })
  $first = $hit | Sort-Object TimeCreated | Select-Object -First 1
  $note = ''
  if ($t.Id -eq 4688 -and $first) { if ($first.Message -match [regex]::Escape($marker)) { $note = 'CommandLine: logged' } else { $note = 'CommandLine: NOT logged' } }
  if (-not $hit.Count -and $ev.Count) { $note = "events with this ID exist ($($ev.Count)), but without marker" }
  $local = 'MISSING'; $lt = ''; $rid = ''
  if ($hit.Count) { $local = 'OK'; $lt = $first.TimeCreated.ToString('yyyy-MM-dd HH:mm:ss'); $rid = $first.RecordId }
  [pscustomobject]@{
    Test = $t.Test; EventID = $t.Id; Log = $t.Log; Local = $local; LocalFound = $hit.Count
    LocalTime = $lt; RecordId = $rid; Before = $t.Before; After = $t.After; Note = $note; Wazuh = ''
  }
}
$rows | Format-Table Test, EventID, Local, LocalFound, LocalTime, RecordId, Note -AutoSize | Out-String -Width 250 | Write-Host
$rows | Export-Csv -LiteralPath $csv -NoTypeInformation -Encoding UTF8

# --- 3. Wazuh agent ---
Step "[3] Wazuh agent"
$svc = Get-Service WazuhSvc -ErrorAction SilentlyContinue
if ($svc) { Write-Host "WazuhSvc service: $($svc.Status)" } else { Write-Host "WazuhSvc service: not found" }
$agentDir = @('C:\Program Files (x86)\ossec-agent', 'C:\Program Files\ossec-agent') | Where-Object { Test-Path $_ } | Select-Object -First 1
if ($agentDir) {
  $state = Join-Path $agentDir 'wazuh-agent.state'
  if (Test-Path $state) {
    Write-Host "wazuh-agent.state:"
    Get-Content $state | Where-Object { $_ -match '^(status|last_keepalive|last_ack|msg_count|msg_sent)' } | ForEach-Object { Write-Host "  $_" }
  }
  $log = Join-Path $agentDir 'ossec.log'
  if (Test-Path $log) {
    Write-Host "ossec.log - last ERROR/WARNING lines:"
    Get-Content $log -Tail 3000 | Where-Object { $_ -match 'ERROR|WARNING' } | Select-Object -Last 15 | ForEach-Object { Write-Host "  $_" }
  }
  $conf = Join-Path $agentDir 'ossec.conf'
  if (Test-Path $conf) {
    $sec = Select-String -LiteralPath $conf -Pattern '<location>Security</location>' -SimpleMatch
    if ($sec) { Write-Host "Security channel in ossec.conf: yes" } else { Write-Host "Security channel in ossec.conf: NO" }
  }
} else { Write-Host "Wazuh agent folder not found" }

# --- 4. What fills PowerShell/Operational (optional: -PsStats, can take a few minutes) ---
if ($PsStats) {
  Step "[4] PowerShell/Operational - Event IDs for last 24h (fast reader, max 300000)"
  $from = (Get-Date).AddHours(-24).ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ss.fffZ')
  $q = New-Object System.Diagnostics.Eventing.Reader.EventLogQuery('Microsoft-Windows-PowerShell/Operational', [System.Diagnostics.Eventing.Reader.PathType]::LogName, "*[System[TimeCreated[@SystemTime>='$from']]]")
  $r = New-Object System.Diagnostics.Eventing.Reader.EventLogReader($q)
  $by = @{}; $n = 0
  while (($e = $r.ReadEvent()) -ne $null) { $k = $e.Id; if ($by.ContainsKey($k)) { $by[$k]++ } else { $by[$k] = 1 }; $e.Dispose(); $n++; if ($n -ge 300000) { break } }
  $r.Dispose()
  Write-Host "  read $n events"
  $by.GetEnumerator() | Sort-Object Value -Descending | Select-Object -First 8 @{n='EventID';e={$_.Key}}, @{n='Count';e={$_.Value}} | Format-Table -AutoSize | Out-String | Write-Host
} else { Step "[4] PowerShell/Operational stats skipped (run with -PsStats to include)" }

Write-Host "`n=== Done. Please send these files: ===" -ForegroundColor Green
Write-Host "  $txt"
Write-Host "  $csv"
Write-Host ("Wazuh search: agent.name:""{0}"" from {1} UTC, marker {2}" -f $env:COMPUTERNAME, $start.ToUniversalTime().ToString('yyyy-MM-dd HH:mm:ss'), $marker)
Stop-Transcript | Out-Null
